-- ia_space/thermal/damage.lua

minetest.register_globalstep(function(dtime)
    -- Run every 1 second
    timer = timer + dtime
    if timer < 1 then return end
    timer = 0

    for _, player in ipairs(minetest.get_connected_players()) do
        local temp = ia_space.get_effective_player_temperature(player)

        -- High Temperature Damage (> 50C)
        if temp > 50 then
            local damage = math.floor((temp - 50) / 10)
            if damage > 0 then
                player:set_hp(player:get_hp() - damage)
                minetest.sound_play("radiant_damage_sizzle", {to_player=player:get_player_name()})
            end

        -- Low Temperature Damage (< -30C)
        elseif temp < -30 then
            local damage = math.floor((math.abs(temp) - 30) / 15)
            if damage > 0 then
                player:set_hp(player:get_hp() - damage)
                -- Frostbite sound or screen effect
            end
        end

        -- Trigger phase changes (Melt/Freeze) around the player
        handle_phase_changes(player:get_pos(), temp)
    end
end)







